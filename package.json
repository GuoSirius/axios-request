{
  "name": "axios-request",
  "version": "1.3.0",
  "type": "module",
  "description": "基于axios的增强请求库，支持token自动刷新、防重复提交、请求取消、失败重试等功能",
  "main": "dist/axios-request.cjs.js",
  "module": "dist/axios-request.esm.js",
  "types": "dist/index.d.ts",
  "umd": "dist/axios-request.umd.js",
  "umdName": "AxiosRequest",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/axios-request.esm.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/axios-request.cjs.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "rollup -c --watch",
    "build": "rollup -c",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "lint:dev": "cross-env NODE_ENV=development eslint src --ext .ts --max-warnings=0",
    "lint:prod": "cross-env NODE_ENV=production eslint src --ext .ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "guard": "npm run typecheck && npm run lint:prod && npm run test",
    "release": "node scripts/release.js",
    "prepare": "husky install"
  },
  "keywords": [
    "axios",
    "request",
    "token",
    "retry",
    "cancel",
    "dedupe",
    "http"
  ],
  "author": "SiriuSSupreme",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bugs": {
    "url": "https://gitee.com/siriussupreme/axios-request/issues"
  },
  "homepage": "https://gitee.com/siriussupreme/axios-request",
  "peerDependencies": {
    "axios": ">=1.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "axios": "^1.15.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "rollup": "^4.60.2",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
