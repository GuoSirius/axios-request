{
  "name": "axios-request",
  "version": "1.1.0",
  "type": "module",
  "description": "基于axios的增强请求库，支持token自动刷新、防重复提交、请求取消、失败重试等功能",
  "main": "dist/axios-request.cjs.js",
  "module": "dist/axios-request.esm.js",
  "types": "dist/index.d.ts",
  "umd": "dist/axios-request.umd.js",
  "umdName": "AxiosRequest",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/axios-request.esm.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/axios-request.cjs.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "rollup -c --watch",
    "build": "rollup -c",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "guard": "npm run typecheck && npm run lint && npm run test",
    "release": "node scripts/release.js",
    "prepare": "husky install"
  },
  "keywords": [
    "axios",
    "request",
    "token",
    "retry",
    "cancel",
    "dedupe",
    "http"
  ],
  "author": "SiriuSSupreme",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bugs": {
    "url": "https://gitee.com/siriussupreme/axios-request/issues"
  },
  "homepage": "https://gitee.com/siriussupreme/axios-request",
  "peerDependencies": {
    "axios": ">=1.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.0.0",
    "@commitlint/config-conventional": "^18.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "axios": "^1.6.0",
    "eslint": "^8.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
